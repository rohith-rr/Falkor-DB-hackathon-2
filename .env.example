# FalkorDB Docker Instance Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=wayfinder_sig_node

# GitHub PAT Token (for GraphQL and REST API queries on kubernetes repos)
GITHUB_TOKEN=

# LLM OpenAPI / OpenAI-compatible API (OpenRouter, OpenAI, LocalAI, vLLM, Ollama)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Embeddings OpenAPI / OpenAI-compatible API
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Local storage configuration (all paths strictly on E: to protect C: drive)
CACHE_DIR=E:/Falkor-DB hackathon 2/.cache
DATA_DIR=E:/Falkor-DB hackathon 2/data

# Extraction & Derived settings
EXTRACTOR_VERSION=v1.0.0
EXPERTISE_WINDOW_DAYS=180
EXPERTISE_HALF_LIFE_DAYS=90
