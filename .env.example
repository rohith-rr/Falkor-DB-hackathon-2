# Copy to .env (ignored by Git). Every key below is optional for the offline paths:
#   python -m wayfinder.company fixture          (Northstar demo graph)
#   python -m wayfinder.company.replay load      (scrubbed live Plane/Slack replay)

# FalkorDB (docker image falkordb/falkordb:v4.20.7)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=wayfinder_company_demo

# Semantic extraction (OpenAI-compatible endpoint). Recorded demo configuration shown.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=mistralai/mistral-nemo

# Embeddings. EMBEDDING_DIM must match the model and the existing vector index.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIM=2048

# Live connectors, only for the designated fictional sandbox
PLANE_API_KEY=
# Bot token: reads channel history and replies, and posts seed/probe messages
SLACK_BOT_TOKEN=
# Optional: a user token used for reading instead of the bot token
SLACK_USER_TOKEN=

# Optional: Kubernetes engineering pilot imports (GitHub GraphQL/REST)
GITHUB_TOKEN=

# Storage. Defaults to .cache/ and data/ inside the checkout.
# CACHE_DIR=
# DATA_DIR=

# Extraction and expertise settings
EXTRACTOR_VERSION=v1.0.0
EXPERTISE_WINDOW_DAYS=30
EXPERTISE_HALF_LIFE_DAYS=15
